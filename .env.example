# Browser app defaults to an isolated local demo. Rebuild when NEXT_PUBLIC values change.
NEXT_PUBLIC_ARCHIVE_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local/CI graph projection only. Never prefix these secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# just seed-invite: SUPABASE_SERVICE_ROLE_KEY (above) plus optional overrides. Server-side only.
INVITE_CODE=
INVITE_EXPIRY_DAYS=

# Hosted scripts (just bootstrap / configure-auth / seed-member / deploy-check). Names and kinds: scripts/hosted-config.mjs.
# Set values in .env.local or GitHub Environments only; never commit them.
SITE_URL=
SEED_MEMBER_NAME=
SEED_MEMBER_EMAIL=

NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
